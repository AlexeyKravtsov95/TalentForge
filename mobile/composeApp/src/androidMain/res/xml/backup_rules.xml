<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower (API 26-30) backup rules (M5.RC.2b, TF-RC1-ANDROID-CONFIG).
  android:allowBackup="false" already disables backup and device transfer there; these
  rules exclude every domain as well, so the policy holds even where they are read.
  Android 12+ uses data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
